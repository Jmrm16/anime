# Cambia el proveedor cuando agregues otro adaptador en src/services/anime-provider.ts
VITE_ANIME_PROVIDER=animeflv

# Puedes apuntar esto a un proxy propio si mantienes el mismo contrato del adaptador actual
VITE_ANIME_API_BASE_URL=https://animeflv.ahmedrangel.com

# Cambialo a false si quieres bloquear iframes externos dentro de la app
VITE_ALLOW_EXTERNAL_EMBEDS=true
